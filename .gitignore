# 游戏本体 AVG 逻辑脚本（`res/luascripts/luascripts.ab` 里 Game.Avg.* 33 支
# Lua 5.3 字节码，剥掉 TextAsset Raw 前缀后落此）：同属第三方代码，本地保留。
# 重导：AssetStudio.CLI.exe luascripts.ab <out> --game FakeHeader
#       --export_type Raw --names "^Game\.Avg\."   再用 tools/lua-disasm.mjs 读
res/Assets/Res/LuaScripts/_logic/

# M10 解包探针的临时目录
.yuntu-bundle/

# M12 音频转码：vgmstream 二进制与转码临时目录不入库。
vgmstream-win64/
tools/media/.tmp/
__pycache__/
tools/frida/captures/

# M12 音源原料（acb/awb，1.1GB）不入库：运行时只读 data/audio 的转码件；
# 本目录仅本地保留，供 unpack-acb.mjs 增量重建。
res/Assets/media/

# 音频转码产物 data/audio/ 自 M15 起随仓库分发（全量本地部署包）；
# 仍可由 res/Assets/media 的 acb/awb 经 `node tools/media/unpack-acb.mjs` 重建。

# 冻结表跑者（tools/ref/freeze.mjs）按 scene 名落 data/fixtures/expected-<scene>.json，
# 全属运行期交接件（test-io 的 zip b64、e2e/五层/play 报告……）每次重新生成，一律不入库；
# 逐条列举会漏（play_report 就是新冒出来的），而真正冻结的基线件命名不带 expected- 前缀
# （scene2/3/4.json、wiki-fades-23carnival.json），所以这里放心用通配。
data/fixtures/expected-*.json

# 一次性调试/探针产物（tmp-*.mjs/.cjs/.html/.png、22child_02 的
# bundles/_probe 探针与实验件、误存成 idx.html 的下载残骸）：
# 本地把玩不入库，历史版本仍可在 M60/M80 提交里查到。
/tmp-*
/bundles/
/idx.html

# IDE 侧跑出来的分析报告件（better-harness 每次运行产 canvas/findings/canvas.tsx）：
# 是工具产物不是项目源数据，本地保留即可，不入库。
.qoder/
